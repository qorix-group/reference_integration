}
hide empty members

class "Shared memory\n/dev/shmem/<ring name>" as SharedRing <<shared memory>> {
  control block (dlt_shm_ring_header)
  slot_count x dlt_shm_ring_slot
  slot_count x payload area
}

class "shm_ring.h\n(valid C99 and C++17)" as ShmRingApi <<C header>> {
  {static} +dlt_shm_ring_required_size(slots, cap) : u32
  {static} +dlt_shm_ring_init(mem, size, slots, cap) : int
  {static} +dlt_shm_ring_attach(ring, mem, size) : int
  {static} +dlt_shm_ring_write(ring, level, app, ctx, num_args, ts_ns, payload, len) : int
  {static} +dlt_shm_ring_peek(ring, slot, payload) : int
  {static} +dlt_shm_ring_release(ring)
}

class dlt_shm_ring_header <<C struct>> {
  magic, version, slot_count
  slot_payload_cap, meta_offset, payload_offset
  enqueue_pos, drops_full, drops_oversize
  dequeue_pos
}

class dlt_shm_ring_slot <<C struct>> {
  sequence : u32
  payload_len : u16
  level : u8
  num_args : u8
  app_id[4], ctx_id[4]
  timestamp_ns : u64
}

class dlt_shm_ring <<C struct>> {
  header : dlt_shm_ring_header*
  slots : dlt_shm_ring_slot*
  payload : u8*
  mask : u32
  slot_payload_cap : u32
}

class ShmRingRecordSource <<consumer>> {
  -ring_ : dlt_shm_ring
  +Attach(mem, size) : bool
  +TryRead(out : LogRecordView&) : bool
}

class ShmRingWriter <<producer>> {
  -ring_name_ : string
  -ring_ : dlt_shm_ring
  -mapping_ : void*
  -attached_ : atomic<bool>
  +ShmRingWriter(ring_name : string)
  +Write(level, app_id, ctx_id, num_of_args, payload, size) : Result
  -EnsureAttached() : bool
}

class "RingRecorder" as RingRecorder <<producer>> {
  -config_ : Configuration
  -slots_ : CircularAllocator<LogRecord>
  -writer_ : unique_ptr<ShmRingWriter>
  +StartRecord(context_id, log_level) : optional<SlotHandle>
  +StopRecord(slot)
  +Log(slot, value)  (22 overloads)
  +IsLogEnabled(level, context) : bool
}

class RingRecorderFactory {
  kDefaultRingName = "/score_dlt_ring"
  kRingNameEnvironmentVariable = "DLT_RING_NAME"
  +ResolveRingName() : string
  +CreateConcreteLogRecorder(config, memory_resource)
}

class "score::mw::log::Recorder" as MwRecorder <<external>>
class "score::mw::log::detail::\nLogRecorderFactory<RingRecorderFactory>" as MwFactory <<external>>

class "ring_producer.c" as RingProducer <<program>> {
  test producer (host and QNX)
}

dlt_shm_ring o-- dlt_shm_ring_header
dlt_shm_ring o-- dlt_shm_ring_slot
SharedRing *-- dlt_shm_ring_header
SharedRing *-- dlt_shm_ring_slot : slot_count x
ShmRingApi ..> dlt_shm_ring : operates on
ShmRingApi ..> SharedRing : defines the layout

ShmRingRecordSource *-- dlt_shm_ring
ShmRingRecordSource ..> ShmRingApi : peek, release
ShmRingRecordSource ..> SharedRing : drains
ShmRingWriter *-- dlt_shm_ring
ShmRingWriter ..> ShmRingApi : write
ShmRingWriter ..> SharedRing : writes
RingProducer ..> ShmRingApi : write
RingProducer ..> SharedRing : writes

RingRecorder --|> MwRecorder
RingRecorder *-- ShmRingWriter
RingRecorderFactory --|> MwFactory
RingRecorderFactory ..> RingRecorder : creates

note bottom of SharedRing
  Created and formatted by the owner: the io-sock module
  (/score_dlt_ring) or ring_forwarder (e.g. /score_dlt_ring_fwd).
  Producers pick the ring with DLT_RING_NAME.
end note
@enduml

