@startuml qnx_iosock_dlt_2_core
title 2 Core: record source -> DLT formatter -> transport (namespace dlt)

left to right direction
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor<<concept>> #E3F0FF
}
hide empty members

enum LogLevel {
  kFatal = 1
  kError
  kWarn
  kInfo
  kDebug
  kVerbose = 6
}

class DltId <<struct>> {
  +chars[4] : char
}

class LogRecordView <<struct>> {
  +payload : const u8*
  +payload_size : usize
  +timestamp : u32  (0.1 ms)
  +log_level : LogLevel
  +num_of_args : u8
  +app_id : DltId
  +ctx_id : DltId
}

interface RecordSource <<concept>> {
  +TryRead(out : LogRecordView&) : bool
}

interface Transport <<concept>> {
  +Send(data : const u8*, size : usize) : bool
}

class SyntheticConfig <<struct>> {
  +record_count : u32
  +first_timestamp : u32
  +timestamp_step : u32
  +log_level : LogLevel
  +app_id : DltId
  +ctx_id : DltId
}

class SyntheticRecordSource {
  -config_ : SyntheticConfig
  -next_ : u32
  -payload_[32] : u8
  +TryRead(out : LogRecordView&) : bool
  +produced() : u32
  +remaining() : u32
}

class ShmRingRecordSource {
  -ring_ : dlt_shm_ring
  -holding_ : bool
  -corrupt_ : u32
  +Attach(mem : void*, size : usize) : bool
  +TryRead(out : LogRecordView&) : bool
  +drops_full() : u32
  +drops_oversize() : u32
  +corrupt() : u32
}

enum FormatStatus {
  kOk
  kInvalidArgument
  kBufferTooSmall
  kPayloadTooLarge
}

class FormatResult <<struct>> {
  +status : FormatStatus
  +size : usize
}

class DltWireFormatter {
  -ecu_id_ : DltId
  -message_counter_ : u8
  +DltWireFormatter(ecu_id : DltId)
  +Format(record, out : u8*, capacity : usize) : FormatResult
  +message_counter() : u8
}

class TransportStats <<struct>> {
  +records_received : u64
  +packets_sent : u64
  +bytes_sent : u64
  +packets_dropped : u64
  +send_failures : u64
  +datagrams_sent : u64
}

class "Pipeline<Source, Transport>" as Pipeline {
  -source_ : Source&
  -transport_ : Transport&
  -formatter_ : DltWireFormatter&
  -stats_ : TransportStats
  -frame_[1472] : u8
  -batch_limit_ : usize
  +Pump(max_records : usize) : usize
  +SetBatchLimit(batch_limit : usize)
  +stats() : const TransportStats&
  +ResetStats()
}

LogRecordView *-- DltId
LogRecordView ..> LogLevel
SyntheticConfig ..> LogLevel
SyntheticRecordSource *-- SyntheticConfig
SyntheticRecordSource ..|> RecordSource
ShmRingRecordSource ..|> RecordSource
SyntheticRecordSource ..> LogRecordView : fills
ShmRingRecordSource ..> LogRecordView : fills
DltWireFormatter *-- DltId
DltWireFormatter ..> LogRecordView : reads
DltWireFormatter ..> FormatResult : returns
FormatResult *-- FormatStatus
Pipeline o-- RecordSource : Source
Pipeline o-- Transport : Transport
Pipeline o-- DltWireFormatter
Pipeline *-- TransportStats

note right of RecordSource
  Seams are template parameters, not virtual
  interfaces (no __cxa_pure_virtual in the module).
end note

note bottom of Pipeline
  Batching: SetBatchLimit(0 or up to 1472 bytes);
  a partial datagram is flushed at the end of every Pump().
end note
@enduml

