@startuml qnx_iosock_dlt_4_boundary
title 4 Boundary: the C API between the core and the module (dlt_c_api.h, dlt_c_api.cpp)

left to right direction
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor<<C module>> #FFF4D6
  BackgroundColor<<C API>> #FFF4D6
  BackgroundColor<<C struct>> #FFF4D6
  BackgroundColor<<external>> #E8E8E8
  BackgroundColor<<concept>> #E3F0FF
  BackgroundColor<<shared memory>> #F9E3F4
}
hide empty members

package "C boundary: dlt_c_api" as Boundary {
  class dlt_transport_ops <<C struct>> {
    ctx : void*
    send : int (*)(ctx, data, size)
  }

  class dlt_config <<C struct>> {
    record_count, first_timestamp, timestamp_step
    log_level, ecu_id[4], app_id[4], ctx_id[4]
  }

  class dlt_stats <<C struct>> {
    records_received, packets_sent, bytes_sent
    packets_dropped, send_failures, datagrams_sent
  }

  class dlt_ring_info <<C struct>> {
    slot_count, slot_payload_cap
    drops_full, drops_oversize, corrupt
  }

  class "dlt_c_api" as CApi <<C API>> {
    {static} +dlt_nanos_to_timestamp(nanos) : u32
    {static} +dlt_session_start(config, ops) : int
    {static} +dlt_session_step(stats) : int
    {static} +dlt_ring_size_for(slots, cap) : size
    {static} +dlt_ring_format(mem, size, slots, cap) : int
    {static} +dlt_ring_start(mem, size, ecu_id, ops) : int
    {static} +dlt_ring_set_batching(max_datagram_bytes)
    {static} +dlt_ring_step(max_records, stats, ring_info) : int
  }

  class CTransport <<adapter>> {
    -ops_ : dlt_transport_ops
    +Bind(ops : const dlt_transport_ops&)
    +Send(data : const u8*, size : usize) : bool
  }

  class "Static sessions\n(anonymous namespace)" as Sessions <<singleton>> {
    synthetic: g_source, g_formatter, g_transport, g_pipeline
    ring: g_ring_source, g_ring_formatter, g_ring_transport, g_ring_pipeline
  }
}

class "Pipeline<Source, Transport>\n(see page 2)" as Pipeline
interface Transport <<concept>>

CTransport ..|> Transport
CTransport *-- dlt_transport_ops
Sessions *-- Pipeline : g_pipeline, g_ring_pipeline
Sessions *-- CTransport
CApi ..> Sessions : drives
CApi ..> dlt_config
CApi ..> dlt_stats
CApi ..> dlt_ring_info

note bottom of CTransport
  Send() forwards to dlt_transport_ops.send:
  in the module dlt_udp_send -> sosend() inside io-sock.
end note
@enduml

