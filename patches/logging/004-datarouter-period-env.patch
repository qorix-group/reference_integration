+// Benchmark hook: DATAROUTER_PERIOD_MS (1..100) shortens the loop, polling and DLT flush period, the default stays 100 ms.
+std::uint32_t LoopPeriodUs() noexcept
+{
+    const char* const value = std::getenv("DATAROUTER_PERIOD_MS");
+    const unsigned long milliseconds = (value != nullptr) ? std::strtoul(value, nullptr, 10) : 0UL;
+    return ((milliseconds >= 1UL) && (milliseconds <= 100UL)) ? static_cast<std::uint32_t>(milliseconds * 1000UL)
+                                                              : kThrottleTimeUs;
+}
